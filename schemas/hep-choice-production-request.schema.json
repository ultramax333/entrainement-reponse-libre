{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hep.local/schemas/hep-choice-production-request.schema.json",
  "title": "Demande de production d’exercices à choix diagnostiques",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "source_batch_id", "count", "batch_size",
    "first_sequence", "level", "target_choice_count", "review_mode", "quotas"
  ],
  "properties": {
    "schema_version": { "const": "hep-choice-production-request/1.0" },
    "request_id": { "type": "string", "pattern": "^hep-cpr1-[0-9]{8}-[0-9]{4}$" },
    "source_batch_id": { "type": "string", "pattern": "^hep-db1-[0-9]{8}-[0-9]{4}$" },
    "count": { "type": "integer", "minimum": 1, "maximum": 500 },
    "batch_size": { "type": "integer", "minimum": 5, "maximum": 20 },
    "first_sequence": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "level": { "const": "bac" },
    "target_choice_count": { "const": 4 },
    "review_mode": { "const": "exhaustive" },
    "quotas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "mechanism_id", "detail_id", "tense_id", "count"],
        "properties": {
          "family": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "mechanism_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "detail_id": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }
            ]
          },
          "tense_id": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }
            ]
          },
          "count": { "type": "integer", "minimum": 1, "maximum": 100 },
          "target_choice_count": { "type": "integer", "minimum": 2, "maximum": 4 }
        }
      }
    }
  }
}
