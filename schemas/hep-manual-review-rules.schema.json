{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hep.local/schemas/hep-manual-review-rules.schema.json",
  "title": "Règles ajoutées manuellement à la révision locale",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"const": "hep-manual-review-rules/1.0"},
    "rules": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "mechanism_id", "detail_id", "tense_id", "reason"],
        "properties": {
          "family": {"type": "string", "minLength": 1},
          "mechanism_id": {"type": "string", "minLength": 1},
          "detail_id": {"type": ["string", "null"]},
          "tense_id": {"type": ["string", "null"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    }
  }
}
